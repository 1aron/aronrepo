{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "bun.lock",
        "tsconfig.json",
        "eslint.config.js",
        "shared/**"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputLogs": "new-only",
            "outputs": [
                "dist/**"
            ]
        },
        "test": {
            "dependsOn": [
                "build",
                "^build"
            ],
            "outputLogs": "new-only",
            "outputs": []
        },
        "lint": {
            "dependsOn": [
                "build",
                "^build"
            ],
            "outputLogs": "new-only",
            "outputs": []
        },
        "type-check": {
            "dependsOn": [
                "build",
                "^build"
            ],
            "outputLogs": "new-only",
            "outputs": []
        }
    }
}
