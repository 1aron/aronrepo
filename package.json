{
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.4",
            "onFail": "ignore"
        }
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "turbo run build --filter=\"./packages/*\"",
        "test": "turbo run test --filter=\"./packages/*\"",
        "lint": "turbo run lint --filter=\"./packages/*\"",
        "type-check": "turbo run type-check --filter=\"./packages/*\"",
        "check:commits": "aronrepo check --from origin/main --to HEAD",
        "check": "pnpm run check:commits && turbo run test lint type-check --filter=\"./packages/*\"",
        "release": "semantic-release"
    },
    "engines": {
        "node": "^26"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/1aron/aronrepo.git"
    },
    "dependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/lint": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.8.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "semantic-release": "^25.0.9",
        "tsdown": "^0.23.5",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "typescript-eslint": "^8.72.1",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    },
    "devDependencies": {
        "aronrepo": "workspace:^",
        "@aronrepo/commitlint-config": "workspace:^",
        "@aronrepo/conventional-changelog-config": "workspace:^",
        "@aronrepo/conventional-commits": "workspace:^",
        "@aronrepo/semantic-release-config": "workspace:^",
        "@aronrepo/semantic-release-pnpm": "workspace:^",
        "@types/js-yaml": "^4.0.9"
    }
}
