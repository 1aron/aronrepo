{
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.4",
            "onFail": "ignore"
        }
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "turbo run build --filter=\"./packages/*\"",
        "test": "turbo run test --filter=\"./packages/*\"",
        "lint": "turbo run lint --filter=\"./packages/*\"",
        "type-check": "turbo run type-check --filter=\"./packages/*\"",
        "aronrepo": "node packages/aronrepo/dist/cli.js",
        "check:commits": "bun run aronrepo check --from origin/main --to HEAD",
        "check": "bun run check:commits && turbo run test lint type-check --filter=\"./packages/*\""
    },
    "engines": {
        "node": "^26"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/1aron/aronrepo.git"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "aronrepo": "workspace:^",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "tsdown": "^0.23.5",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
