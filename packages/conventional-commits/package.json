{
    "name": "@aronrepo/conventional-commits",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "description": "Aronrepo conventional commit types, release policy modes, release path checks, and AI agent commit policy.",
    "repository": {
        "type": "git",
        "url": "https://github.com/1aron/aronrepo.git",
        "directory": "packages/conventional-commits"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js",
            "default": "./dist/node.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest",
        "type-check": "tsc --noEmit",
        "lint": "eslint"
    },
    "dependencies": {
        "js-yaml": "^5.5.0",
        "picomatch": "^4.0.7",
        "tinyglobby": "^0.2.17"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/picomatch": "^4.0.3"
    }
}
