{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        // tsdown builds dist; tsc only type-checks, so a bare `tsc` cannot emit stray files into dist.
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
    ]
}
