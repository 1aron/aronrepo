{
    "name": "aronrepo",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "description": "Aronrepo toolchain facade and CLI for release policies that coding agents can follow.",
    "repository": {
        "type": "git",
        "url": "https://github.com/1aron/aronrepo.git",
        "directory": "packages/aronrepo"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "bin": {
        "aronrepo": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest",
        "type-check": "tsc --noEmit",
        "lint": "eslint"
    },
    "peerDependencies": {
        "@commitlint/cli": "*",
        "semantic-release": "*"
    },
    "dependencies": {
        "@aronrepo/commitlint-config": "workspace:^",
        "@aronrepo/conventional-changelog-config": "workspace:^",
        "@aronrepo/conventional-commits": "workspace:^",
        "@aronrepo/semantic-release-config": "workspace:^",
        "@aronrepo/semantic-release-pnpm": "workspace:^"
    }
}
